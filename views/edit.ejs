<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel = "icon" href="https://img.icons8.com/officel/80/making-notes.png">
</head>
<body>

    <div class = "main w-full min-h-screen bg-zinc-900 p-10 text-white">
        
        <a class= "text-blue-500 inline-block mb-10" href="/">Go Back to Home</a>

           <form action="/edit" method="POST" class="flex flex-col gap-2">

                <input
                    type="text"
                    name="previous"
                    placeholder="Previous Name "
                    value="<%=filename%>"
                    readonly
                    class="w-1/5 px-5 py-2 rounded-md bg-zinc-800 outline-none "
                    
                   
                >
                <input
                    type="text"
                    name="new"
                    placeholder="New Name"
                    class="w-1/5 px-5 py-2 rounded-md bg-zinc-800 outline-none"
                >
               <h1 class = "text-xl font-bold ">Data</h1>
                <input
                    type="text"
                    name="previous_data"
                    placeholder="Previous Data "
                    value="<%=filedata%>"
                    class="w-full px-5 py-2 rounded-md bg-zinc-800 outline-none ">


                <button class="w-fit bg-yellow-600 px-4 py-2 rounded-md" id="Update_data">
                    Update Filename
                </button>

            </form>    
</body>
</html>