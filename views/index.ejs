<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel = "icon" href="https://img.icons8.com/officel/80/making-notes.png">
</head>
<body>

    <div class="main w-full min-h-screen bg-zinc-900">

        <div class="form p-10 text-white">

            <form action="/create" method="POST" class="flex flex-col gap-2">

                <input
                    type="text"
                    name="title"
                    placeholder="Title goes here..."
                    class="w-full px-5 py-2 rounded-md bg-zinc-800 outline-none"
                >

                <textarea
                    name="details"
                    placeholder="Write your task details here..."
                    class="w-full px-5 py-2 rounded-md bg-zinc-800 outline-none resize-none"
                ></textarea>

                <button class="w-fit bg-blue-600 px-4 py-2 rounded-md">
                    Create Task
                </button>

            </form>

        </div>

        <div class="tasks flex gap-3 flex-wrap p-10">

            <% if(files.length > 0){ %>

                <% files.forEach(function(val){ %>

                    <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800 text-white">

                        <h3 class="text-xl font-semibold break-words">
                            <%= val %>
                        </h3>

                        <div class = "flex w-full justify-between items-center mt-3">
                            <a href="/file/<%= val %>" class="text-blue-500 text-sm inline-block">
                            Read More
                        </a>
                        <a href="/edit/<%=val%>" class="text-zinc-500 underline">Edit File</a>
                         </a>
                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <h3 class="text-zinc-600">No tasks yet.</h3>

            <% } %>

        </div>

    </div>

</body>
</html>